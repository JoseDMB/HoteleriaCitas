@model AccessDB.Models.Reservacion
@using AccessDB.Models
@{
    ViewData["Title"] = "Editar Reservación";
    var clientes = ViewData["Cliente"] as List<Cliente> ?? new List<Cliente>();
    var habitaciones = ViewData["Habitacion"] as List<Habitacion> ?? new List<Habitacion>();
    var estadosReservacion = ViewData["EstadosReserva"] as List<EstadoReserva> ?? new List<EstadoReserva>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a href="@Url.Action("Index", "Reservacion")" class="btn btn-ghost">← Volver</a>
                <h1>Editar Reservación</h1>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>⚠️ Errores en el formulario:</strong>
                    <ul class="mb-0 mt-2">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="surface p-4">
                <form asp-action="Edit" asp-controller="Reservacion" asp-route-id="@Model.Id" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="CodigoReserva" class="form-label">Código de reservación</label>
                        <input asp-for="CodigoReserva" class="form-control" readonly />
                        <span class="form-text text-muted">El código se genera automáticamente al crear la reservación</span>
                        <span asp-validation-for="CodigoReserva" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdCliente" class="form-label">Cliente</label>
                        <select asp-for="IdCliente" class="form-control">
                            <option value="">-- Selecciona --</option>
                            @foreach (var cli in clientes)
                            {
                                if (Model.IdCliente == cli.Id)
                                {
                                    <option value="@cli.Id" selected="selected">@($"{cli.Nombre} {cli.PrimerApellido} {cli.SegundoApellido}".Trim()) (@cli.Cedula)</option>
                                }
                                else
                                {
                                    <option value="@cli.Id">@($"{cli.Nombre} {cli.PrimerApellido} {cli.SegundoApellido}".Trim()) (@cli.Cedula)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdCliente" class="text-danger small"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="IdHabitacion" class="form-label">Habitación</label>
                        <select asp-for="IdHabitacion" class="form-control" id="IdHabitacion">
                            <option value="">-- Selecciona --</option>

                            @foreach (var hab in habitaciones)
                            {
                                if (Model.IdHabitacion == hab.Id)
                                {
                                    <option value="@hab.Id"
                                            data-tarifa="@hab.TarifaxNoche"
                                            selected="selected">
                                        @hab.NumeroHabitacion - @hab.TarifaxNoche.ToString("C")
                                    </option>
                                }
                                else
                                {
                                    <option value="@hab.Id"
                                            data-tarifa="@hab.TarifaxNoche">
                                        @hab.NumeroHabitacion - @hab.TarifaxNoche.ToString("C")
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="IdHabitacion" class="text-danger small"></span>
                    </div>


                    <div class="form-section mb-4">
                        <h5 class="mb-3">
                            <span class="kicker">📅</span> Fecha de ingreso y salida
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaIngreso" class="form-label">Fecha de ingreso <span class="text-danger">*</span></label>
                                <input asp-for="FechaIngreso" type="date" class="form-control" required />
                                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaSalida" class="form-label">Fecha de salida <span class="text-danger">*</span></label>
                                <input asp-for="FechaSalida" type="date" class="form-control" required />
                                <span asp-validation-for="FechaSalida" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-section mb-4">
                            <h5 class="mb-3">
                                <span class="kicker">📝</span> Solicitudes y Descuento
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Solicitudes" class="form-label">Solicitudes especiales</label>
                                <textarea asp-for="Solicitudes" class="form-control" rows="3" maxlength="300"></textarea>
                                <span asp-validation-for="Solicitudes" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Descuento" class="form-label">Porcentaje de descuento</label>
                                <input asp-for="Descuento" type="number" min="0" max="100" class="form-control" />
                                <span asp-validation-for="Descuento" class="text-danger small"></span>
                            </div>

                            <!-- Mostrar tarifa calculada y monto total (solo como referencia) -->
                            <div class="mb-3">
                                <label class="form-label">Tarifa estimada</label>
                                <p id="tarifaDisplay" class="h5 text-primary">--</p>
                                <input type="hidden" asp-for="TarifaReservacion" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Monto total estimado (con IVA)</label>
                                <p id="montoDisplay" class="h5 text-success">--</p>
                                <input type="hidden" asp-for="Total" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CantidadPersonas" class="form-label">Cantidad de personas</label>
                            <select asp-for="CantidadPersonas" class="form-control">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    if (Model.CantidadPersonas == i)
                                    {
                                        <option value="@i" selected="selected">@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CantidadPersonas" class="text-danger small"></span>
                        </div>

                    <div class="mb-3">
                        <label asp-for="EstadoReservacion" class="form-label">Estado</label>
                        <select asp-for="EstadoReservacion" class="form-control">
                            <option value="">-- Seleccione --</option>
                            @foreach (var estado in estadosReservacion)
                            {
                                if (Convert.ToInt32(Model.EstadoReservacion) == estado.Id)
                                {
                                    <option value="@estado.Id" selected="selected">@estado.Nombre</option>
                                }
                                else
                                {
                                    <option value="@estado.Id">@estado.Nombre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="EstadoReservacion" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="submit" class="btn btn-primary flex-sm-grow-1">✓ Guardar Cambios</button>
                        <a href="@Url.Action("Index", "Reservacion")" class="btn btn-outline-custom flex-sm-grow-1">✕ Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        <script>
            const serverDecimalSeparator = '@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator';

            function calcularEstimado() {
                // HABITACIÓN
                const selHabitacion = document.querySelector('[name="IdHabitacion"]');

                if (!selHabitacion) {
                    console.error('No se encontró el campo IdHabitacion');
                    return;
                }

                const selectedOption = selHabitacion.selectedOptions[0];

                const tarifaStr = selectedOption
                    ? selectedOption.dataset.tarifa
                    : null;

                const tarifa = tarifaStr
                    ? parseFloat(tarifaStr)
                    : 0;

                // FECHAS
                const ingreso = document.querySelector('[name="FechaIngreso"]').value;
                const salida = document.querySelector('[name="FechaSalida"]').value;

                // DESCUENTO
                const descuentoInput = document.querySelector('[name="Descuento"]');
                const descuento = descuentoInput
                    ? parseFloat(descuentoInput.value || '0')
                    : 0;

                // Validaciones
                if (!ingreso || !salida || tarifa <= 0) {
                    document.getElementById('tarifaDisplay').innerText = '--';
                    document.getElementById('montoDisplay').innerText = '--';

                    document.querySelector('[name="TarifaReservacion"]').value = '';
                    document.querySelector('[name="Total"]').value = '';

                    return;
                }

                // FECHAS
                const d1 = new Date(ingreso + 'T00:00:00');
                const d2 = new Date(salida + 'T00:00:00');

                const diferencia = d2 - d1;

                let noches = Math.round(
                    diferencia / (1000 * 60 * 60 * 24)
                );

                if (noches <= 0) {
                    noches = 1;
                }

                // CÁLCULO
                const tarifaTotal = tarifa * noches;

                const montoDescuento =
                    tarifaTotal * (descuento / 100);

                const tarifaConDesc =
                    tarifaTotal - montoDescuento;

                const iva =
                    tarifaConDesc * 0.13;

                const monto =
                    tarifaConDesc + iva;

                // MOSTRAR EN PANTALLA
                document.getElementById('tarifaDisplay').innerText =
                    tarifaTotal.toLocaleString(undefined, {
                        style: 'currency',
                        currency: 'CRC'
                    });

                document.getElementById('montoDisplay').innerText =
                    monto.toLocaleString(undefined, {
                        style: 'currency',
                        currency: 'CRC'
                    });

                // FORMATO PARA EL SERVIDOR
                function formatForServerNumber(val) {
                    let s = Number(val).toFixed(2);

                    if (serverDecimalSeparator !== '.') {
                        s = s.replace('.', serverDecimalSeparator);
                    }

                    return s;
                }

                // INPUTS HIDDEN
                document.querySelector('[name="TarifaReservacion"]').value =
                    formatForServerNumber(tarifaTotal);

                document.querySelector('[name="Total"]').value =
                    formatForServerNumber(monto);

                console.log({
                    tarifa,
                    noches,
                    tarifaTotal,
                    descuento,
                    tarifaConDesc,
                    iva,
                    monto
                });
            }

            // Cuando cambian habitación, fechas o descuento
            document.addEventListener('change', function(e) {

                if (
                    e.target.name === 'IdHabitacion' ||
                    e.target.name === 'FechaIngreso' ||
                    e.target.name === 'FechaSalida' ||
                    e.target.name === 'Descuento'
                ) {
                    calcularEstimado();
                }
            });

            // Mientras escriben el descuento
            document.addEventListener('input', function(e) {

                if (e.target.name === 'Descuento') {
                    calcularEstimado();
                }
            });

            // Calcular también al cargar la página
            document.addEventListener('DOMContentLoaded', function() {
                calcularEstimado();
            });
        </script>
}
