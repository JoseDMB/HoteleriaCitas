@model List<AccessDB.Models.Habitacion>
@using AccessDB.Models

@{
    ViewData["Title"] = "Gestión de Habitaciones";
}

@inject MVC.Interfaces.ITipoHabitacionService TipoHabitacionService

@{
    ViewData["Title"] = "Gestión de Habitaciones";
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestión de Habitaciones</h1>
            <p class="text-muted-custom">Total registradas: <strong>@Model.Count</strong></p>
        </div>
        <a href="@Url.Action("Create", "Habitaciones")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva habitación
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Éxito:</strong> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Section -->
    <div class="surface mb-4">
        <form method="get" action="@Url.Action("Index", "Habitaciones")" class="row g-3">
            <div class="col-md-8">
                <input type="text" name="buscar" class="form-control" placeholder="Buscar numero de habitación" 
                       value="@ViewData["BusquedaTermino"]">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
                <a href="@Url.Action("Index", "Habitaciones")" class="btn btn-ghost w-100 mt-2">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Employees Table -->
    @if (Model.Count == 0)
    {
        <div class="surface text-center py-5">
            <p class="text-muted-custom mb-3">No hay habitaciones registradas</p>
            <a href="@Url.Action("Create", "Habitaciones")" class="btn btn-primary">
                Registrar la primera habitación
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Numero de habitación</th>
                        <th>Tipo de habitación</th>
                        <th>Tarifa por noche</th>
                        <th>Tarifa Satelital</th>
                        <th>Pendientes de mantenimiento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var habitacion in Model)
                    {
                        <tr>
                            <td>
                                <code>@habitacion.NumeroHabitacion</code>
                            </td>
                            <td>
                                <span class="badge-custom">
                                    @((await TipoHabitacionService.ObtenerPorIdAsync(habitacion.TipoHabitacion))?.Nombre)
                                </span>
                            </td>
                            <td>
                                <span class="text-primary">₡ @habitacion.TarifaxNoche.ToString("N2")</span>
                            </td>
                            <td>
                                @if (habitacion.Tv_Satelital)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }

                            </td>
                            <td>
                                <span class="text-primary">@habitacion.PendientesMantenimiento</span>
                            </td>
                            
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", "Habitaciones", new { id = habitacion.NumeroHabitacion })" 
                                       class="btn btn-sm btn-outline-custom" title="Ver detalles">
                                        👁️ Ver
                                    </a>
                                    <a href="@Url.Action("Edit", "Habitaciones", new { id = habitacion.NumeroHabitacion })"
                                       class="btn btn-sm btn-outline-custom" title="Editar">
                                        ✏️ Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Habitaciones", new { id = habitacion.NumeroHabitacion })"
                                       class="btn btn-sm btn-outline-custom" title="Eliminar">
                                        🗑️ Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table {
        margin-top: 0;
    }

    .table thead th {
        font-weight: 600;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding: 1rem 1.75rem;
    }

    .table tbody td {
        padding: 0.9rem 0.75rem;
        vertical-align: middle;
    }

    .btn-group {
        display: flex;
        gap: 0.25rem;
    }

    .btn-group .btn {
        padding: 0.35rem 0.65rem;
        font-size: 0.85rem;
    }

    code {
        background: rgba(45, 212, 191, 0.08);
        color: var(--primary);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .badge-custom {
        background: rgba(124, 131, 255, 0.12);
        color: var(--accent);
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
    }
</style>
