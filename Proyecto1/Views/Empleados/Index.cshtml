@model List<AccessDB.Models.Empleado>
@using AccessDB.Models

@{
    ViewData["Title"] = "Gestión de Empleados";
}

@inject MVC.Interfaces.ICategoriaApiService categoriaService
@inject MVC.Interfaces.IUbicacionService ubicacionService

@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestión de Empleados</h1>
            <p class="text-muted-custom">Total registrados: <strong>@Model.Count</strong></p>
        </div>
        <a href="@Url.Action("Create", "Empleados")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Empleado
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Éxito:</strong> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Section -->
    <div class="surface mb-4">
        <form method="get" action="@Url.Action("Index", "Empleados")" class="row g-3">
            <div class="col-md-8">
                <input type="text" name="buscar" class="form-control" placeholder="Buscar por nombre, apellido, cédula o categoría..." 
                       value="@ViewData["BusquedaTermino"]">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
                <a href="@Url.Action("Index", "Empleados")" class="btn btn-ghost w-100 mt-2">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Employees Table -->
    @if (Model.Count == 0)
    {
        <div class="surface text-center py-5">
            <p class="text-muted-custom mb-3">No hay empleados registrados</p>
            <a href="@Url.Action("Create", "Empleados")" class="btn btn-primary">
                Registrar el primer empleado
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre Completo</th>
                        <th>Categoría</th>
                        <th>Salario Mensual</th>
                        <th>Fecha Ingreso</th>
                        <th>Ubicación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empleado in Model)
                    {
                        <tr>
                            <td>
                                <code>@empleado.Cedula</code>
                            </td>
                            <td>
                                <strong>@($"{empleado.Nombre} {empleado.PrimerApellido} {empleado.SegundoApellido}".Trim())</strong>
                            </td>
                            <td>
                                <span class="badge-custom">
                                    @((await categoriaService.ObtenerPorIdAsync(empleado.CategoriaId))?.Nombre)
                                </span>
                            </td>
                            <td>
                                <span class="text-primary">₡ @empleado.SalarioMensual.ToString("N2")</span>
                            </td>
                            <td>
                                <small>@empleado.FechaIngreso.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <small class="text-muted-custom">
                                    @{
                                        var provincia = await ubicacionService.GetProvinciaByIdAsync(empleado.ProvinciaId);
                                        var distrito = await ubicacionService.GetDistritoByIdAsync(empleado.DistritoId);
                                        var canton = await ubicacionService.GetCantonByIdAsync(empleado.CantonId);
                                    }
                                    @if (provincia != null && distrito != null && canton != null)
                                    {
                                        <span>@provincia.Nombre, @canton.Nombre</span>
                                    }
                                </small>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", "Empleados", new { id = empleado.Id })" 
                                       class="btn btn-sm btn-outline-custom" title="Ver detalles">
                                        👁️ Ver
                                    </a>
                                    <a href="@Url.Action("Edit", "Empleados", new { id = empleado.Id })" 
                                       class="btn btn-sm btn-outline-custom" title="Editar">
                                        ✏️ Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Empleados", new { id = empleado.Id })" 
                                       class="btn btn-sm btn-outline-custom" title="Eliminar">
                                        🗑️ Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table {
        margin-top: 0;
    }

    .table thead th {
        font-weight: 600;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding: 1rem 0.75rem;
    }

    .table tbody td {
        padding: 0.9rem 0.75rem;
        vertical-align: middle;
    }

    .btn-group {
        display: flex;
        gap: 0.25rem;
    }

    .btn-group .btn {
        padding: 0.35rem 0.65rem;
        font-size: 0.85rem;
    }

    code {
        background: rgba(45, 212, 191, 0.08);
        color: var(--primary);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .badge-custom {
        background: rgba(124, 131, 255, 0.12);
        color: var(--accent);
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
    }
</style>
