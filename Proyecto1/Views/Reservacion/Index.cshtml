@model List<Proyecto1.ViewModels.ReservacionIndexViewModel>
@using System
@using System.Linq
@{
    ViewData["Title"] = "Reservaciones";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Reservaciones</h1>
        </div>
        <a href="@Url.Action("Create", "Reservacion")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Reservación
        </a>
    </div>

    
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cliente</th>
                    <th>Habitación</th>
                    <th>Fechas</th>
                    <th>Tarifa</th>
                    <th>Monto Total(IVA)</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var r in Model)
                {
                    <tr>
                        <td><code>@r.CodigoReserva</code></td>
                        <td>@r.ClienteNombre</td>
                        <td>@r.HabitacionNumero</td>
                        <td><small>@r.FechaIngreso.ToString("dd/MM/yyyy") - @r.FechaSalida.ToString("dd/MM/yyyy")</small></td>
                        <td>@r.TarifaReservacion.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                        <td>@r.Total.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                        <td>@r.EstadoNombre</td>
                          <td>
                            <a href="@Url.Action("Details", "Reservacion", new { id = r.Id })" class="btn btn-sm btn-outline-custom">Ver</a>
                            <a href="@Url.Action("Edit", "Reservacion", new { id = r.Id })" class="btn btn-sm btn-outline-custom">Editar</a>
                            <a href="@Url.Action("Delete", "Reservacion", new { id = r.Id })" class="btn btn-sm btn-outline-custom">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table {
        margin-top: 0;
    }

    .table thead th {
        font-weight: 600;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding: 1rem 0.75rem;
    }

    .table tbody td {
        padding: 0.9rem 0.75rem;
        vertical-align: middle;
    }

    .btn-group {
        display: flex;
        gap: 0.25rem;
    }

    .btn-group .btn {
        padding: 0.35rem 0.65rem;
        font-size: 0.85rem;
    }

    code {
        background: rgba(45, 212, 191, 0.08);
        color: var(--primary);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .badge-custom {
        background: rgba(124, 131, 255, 0.12);
        color: var(--accent);
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
    }
</style>
