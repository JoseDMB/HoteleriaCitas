@model AccessDB.Models.Cliente

@{
    ViewData["Title"] = $"Eliminar - {Model.Nombre}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <!-- Header -->
            <div class="mb-4">
                <a href="@Url.Action("Index", "Clientes")" class="btn btn-ghost mb-3">← Volver</a>
                <h1>Confirmar Eliminación</h1>
            </div>

            <!-- Warning Alert -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>⚠️ Error:</strong> @TempData["Error"]
                </div>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    <strong>⚠️ Atención:</strong> Esta acción es irreversible.
                </div>
            }

            <!-- Client Information -->
            <div class="surface mb-4">
                <div class="mb-3">
                    <label class="form-label text-muted-custom">Nombre Completo</label>
                    <p class="h5">@Model.Nombre</p>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted-custom">Cédula</label>
                    <p><code>@Model.Cedula</code></p>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted-custom">Fecha de Nacimiento</label>
                    <p>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="mb-0">
                    <label class="form-label text-muted-custom">Registrado</label>
                    <p class="text-muted-custom mb-0">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
            </div>

            <!-- Confirmation Message -->
            <div class="surface p-3 mb-4 bg-danger bg-opacity-10">
                <p class="mb-0">
                    <strong>¿Está seguro de que desea eliminar a</strong> <code>@Model.Nombre</code> <strong>?</strong>
                </p>
            </div>

            <!-- Action Buttons -->
            <form asp-action="Delete" asp-controller="Clientes" method="post" class="d-grid gap-2 d-sm-flex">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-danger flex-sm-grow-1">
                    🗑️ Sí, Eliminar
                </button>
                <a href="@Url.Action("Index", "Clientes")" class="btn btn-outline-custom flex-sm-grow-1">
                    ✕ Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

<style>
    .btn-danger {
        background-color: var(--danger);
        border-color: var(--danger);
        color: #E60E0E;
    }

        .btn-danger:hover {
            background-color: #262626;
        }

    .bg-danger {
        background-color: #262626
    }

    /* .bg-opacity-10 {
            opacity: 0.1;
        } */

    code {
        background: rgba(45, 212, 191, 0.08);
        color: var(--primary);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }
</style>
